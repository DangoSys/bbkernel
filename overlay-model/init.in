#!/bin/sh
set -e

[ -c /dev/console ] || {
  echo "ERROR: /dev/console is missing or not a character device" >&2
  exit 1
}

[ -c /dev/null ] || {
  echo "ERROR: /dev/null is missing or not a character device" >&2
  exit 1
}

exec </dev/console >/dev/console 2>&1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo ""
cat <<'EOF'
     __  __                               __          ____
    / / / /___ __   _____      ____ _    / /_  ____ _/ / /
   / /_/ / __ `/ | / / _ \    / __ `/   / __ \/ __ `/ / /
  / __  / /_/ /| |/ /  __/   / /_/ /   / /_/ / /_/ / / /
 /_/ /_/\__,_/ |___/\___/    \__,_/   /_.___/\__,_/_/_/
EOF
echo ""
echo "[model] @BUCKYBALL_KERNEL_MODEL@ via /init"
echo ""

fail_exit() {
  echo "$1" >&2
  reboot -f
}

cd /root || fail_exit "ERROR: cannot cd /root"
t=./@MODEL_RUN_BINARY@
[ -x "$t" ] || fail_exit "ERROR: missing $t"
echo "RUN @MODEL_RUN_BINARY@"
set +e
"$t"
rc=$?
set -e
echo "rc=$rc"
[ "$rc" -eq 0 ] || fail_exit "FAIL @MODEL_RUN_BINARY@ rc=$rc"
echo "PASS @MODEL_RUN_BINARY@"
poweroff -f
